# Yerel SQLite (npx prisma generate --schema prisma/schema.sqlite.prisma)
# DATABASE_URL="file:./dev.db"

# Üretim / schema.prisma: PostgreSQL. Transaction pooler 6543 + pgbouncer
DATABASE_URL="postgres://postgres.[ref]:[şifre]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgres://postgres.[ref]:[şifre]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# AUTH_SECRET en az 16 karakter. Üretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_URL="http://127.0.0.1:3000"
# Vercel Cron bu değeri Authorization: Bearer olarak gönderir. Dakikalık cron için Pro plan.
CRON_SECRET=

GOOGLE_PLACES_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
LLM_API_KEY=
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_MODEL="gemini-3.5-flash"
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_WEBHOOK_VERIFY_TOKEN=
