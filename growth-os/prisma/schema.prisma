generator client {
  provider = "prisma-client-js"
}

// Yerel SQLite. Üretim şeması: prisma/schema.prisma (postgresql).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id
  slug      String   @unique
  name      String
  vertical  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  campaigns  Campaign[]
  leads      Lead[]
  templates  Template[]
  jobs       OutreachJob[]
  playbook   BrandPlaybook?
  coach      CoachMessage[]
  igThreads  IgThread[]
  settings   AppSettings?
  auditLogs  AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorEmail String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model Campaign {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  query        String
  city         String
  district     String   @default("")
  targetCount  Int
  minRating    Float    @default(0)
  requirePhone Boolean  @default(true)
  phonePrefix  String   @default("")
  websiteFilter String  @default("any")
  status       String   @default("idle")
  foundCount   Int      @default(0)
  skippedCount Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]

  @@index([tenantId, createdAt])
}

model Lead {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  placeId     String
  campaignId  String?
  campaign    Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name        String
  address     String         @default("")
  phone       String         @default("")
  website     String         @default("")
  rating      Float?
  reviewCount Int?
  mapsUrl     String         @default("")
  lat         Float?
  lng         Float?
  district    String         @default("")
  city        String         @default("")
  status      String         @default("yeni")
  notes       String         @default("")
  consented   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  jobs        OutreachJob[]

  @@unique([tenantId, placeId])
  @@index([tenantId, createdAt])
}

model Template {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, name])
}

model OutreachJob {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId  String?
  message     String
  status      String    @default("pending")
  channel     String    @default("whatsapp")
  error       String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status, scheduledAt])
}

model BrandPlaybook {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tone      String   @default("")
  rules     String   @default("")
  forbidden String   @default("")
  offer     String   @default("")
  cta       String   @default("")
  updatedAt DateTime @updatedAt
}

model CoachMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      String
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model IgThread {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  igsid     String      @default("")
  username  String      @default("")
  lastText  String      @default("")
  lastAt    DateTime?
  draft     String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  IgMessage[]

  @@unique([tenantId, igsid])
}

model IgMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    IgThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction String
  body      String
  createdAt DateTime @default(now())
}

model AppSettings {
  tenantId             String  @id
  tenant               Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googlePlacesApiKey   String  @default("")
  waCloudToken         String  @default("")
  waPhoneNumberId      String  @default("")
  campaignMediaEnabled Boolean @default(false)
  campaignMediaType    String  @default("")
  campaignMediaUrl     String  @default("")
  campaignMediaId      String  @default("")
  campaignMediaName    String  @default("")
  delayMinSec          Int     @default(20)
  delayMaxSec          Int     @default(45)
  dailyCap             Int     @default(40)
  queuePaused          Boolean @default(false)
  queueStopped         Boolean @default(false)
  llmApiKey            String  @default("")
  llmBaseUrl           String  @default("https://generativelanguage.googleapis.com/v1beta/openai")
  llmModel             String  @default("gemini-3.5-flash")
  llmProvider          String  @default("gemini")
  igAccessToken        String    @default("")
  igUserId             String    @default("")
  igWebhookVerifyToken String    @default("")
  waWebState           String    @default("disconnected")
  waWebQr              String    @default("")
  waWebError           String    @default("")
  waWebCreds           String    @default("")
  waWebPairId          String    @default("")
  waWebPairingUntil    DateTime?
}
