{
  "name": "orbit",
  "productName": "Orbit",
  "version": "1.16.0",
  "description": "Orbit by wexon.dev — kişisel bilgisayar kontrol merkezi: tek tıkla kurulum, RGB, ESP32, Growth OS ve öğrenen asistan",
  "main": "src/main/main.js",
  "author": "wexon.dev",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/mlevncomm/orbit",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "growth": "node scripts/build-growth.js",
    "dist": "node scripts/build-growth.js && electron-builder --win --publish never",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "test": "node --test tests/unit/",
    "test:integration": "node --test --test-concurrency=1 tests/integration/",
    "test:hardware": "node --test --test-concurrency=1 tests/hardware/",
    "mcp": "node plugins/orbit-mcp/index.js"
  },
  "build": {
    "copyright": "© 2026 wexon.dev",
    "afterPack": "scripts/after-pack.js",
    "appId": "com.mlevn.orbit",
    "productName": "Orbit",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "Orbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mlevncomm",
        "repo": "orbit",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "growth-os/.next/standalone",
        "to": "growth",
        "filter": ["**/*", "**/.next/**", "**/node_modules/**", "**/.prisma/**"]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "simple-icons": "^16.35.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "electron-updater": "^6.8.9",
    "openrgb-sdk": "^0.6.0",
    "pg": "^8.23.1"
  }
}
