{
  "name": "orbit",
  "productName": "Orbit",
  "version": "1.7.0",
  "description": "Format sonrası tek tıkla sürücü ve program kurulumu, RGB aydınlatma kontrolü ve kişisel AI asistanı",
  "main": "src/main/main.js",
  "author": "mlevncomm",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/mlevncomm/orbit",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "test": "node --test tests/unit/",
    "test:integration": "node --test --test-concurrency=1 tests/integration/",
    "test:hardware": "node --test --test-concurrency=1 tests/hardware/",
    "mcp": "node plugins/orbit-mcp/index.js"
  },
  "build": {
    "appId": "com.mlevn.orbit",
    "productName": "Orbit",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "Orbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mlevncomm",
        "repo": "orbit",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "electron-updater": "^6.8.9",
    "openrgb-sdk": "^0.6.0"
  }
}
